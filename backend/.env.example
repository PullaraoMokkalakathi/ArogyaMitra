# ══════════════════════════════════════════════════════════════
# ArogyaMitra Backend — Environment Variables
# ══════════════════════════════════════════════════════════════
# HOW TO USE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in actual values in .env
#   3. NEVER commit .env to GitHub
#   4. Keep .env inside .gitignore
# ══════════════════════════════════════════════════════════════


# ── Application ────────────────────────────────────────────────
APP_NAME=ArogyaMitra
ENVIRONMENT=development
# Options: development | staging | production
DEBUG=false
PORT=8000
HOST=0.0.0.0


# ── Database ───────────────────────────────────────────────────
# Development (SQLite)
DATABASE_URL=sqlite:///./arogya_mitra.db

# Production (PostgreSQL / Supabase)
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST].supabase.co:5432/postgres


# ── JWT / Security ─────────────────────────────────────────────
# Generate a strong key for production:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7


# ── AI — Gemini ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash


# ── AI — Groq ──────────────────────────────────────────────────
# Get key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile


# ── CORS ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# In PRODUCTION, set to your EXACT deployed frontend URL(s). Wildcards (*) are NOT allowed.
# Example: CORS_ORIGINS=https://your-app.vercel.app
# For multiple origins: CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000


# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_GENERAL=100/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_AI=10/minute
